# --- ОБЯЗАТЕЛЬНО: задайте свой пароль ---
# Этот же пароль указывается как apiKey в настройках Continue.
AIM_PASSWORD=change-me

# Адрес сервиса. 0.0.0.0 = доступен всем устройствам в локальной сети.
AIM_HOST=0.0.0.0
AIM_PORT=8000
# Адрес, который AI Manager сообщает другим устройствам (endpoint/инструкции).
# Не задан — определяется автоматически по IP локальной сети.
# AIM_PUBLIC_HOST=192.168.1.50

# Пути
AIM_REGISTRY=config/models.registry.json
LLAMA_SERVER_BIN=llama-server/llama-server.exe
AIM_PORT_RANGE=8100-8199
AIM_HF_CACHE=%USERPROFILE%\.cache\ai-manager

# Поведение
AIM_AUTO_INSTALL=false
AIM_GPU_LAYERS=99

# Для сборки llama-server SYCL (не нужно для Vulkan):
# ONEAPI_DEVICE_SELECTOR=level_zero:gpu